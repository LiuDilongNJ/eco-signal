# Public domain
# HTTP mode serves the frontend, API, and media from this host and FRONTEND_PORT.
# HTTPS mode serves the frontend at dashboard.DOMAIN and the API at api.DOMAIN.
DOMAIN=localhost
FRONTEND_PORT=80

# Environment: local, staging, production
ENVIRONMENT=local
ENABLE_HTTPS=false
# Required only when ENABLE_HTTPS=true for Let's Encrypt certificate notifications.
EMAIL=admin@example.com
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_HASH=

PROJECT_NAME="ecoSignal"
STACK_NAME=ecosignal

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173"
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
OPERATION_LOG_DB_POOL_SIZE=2
OPERATION_LOG_DB_MAX_OVERFLOW=1
SECRET_KEY=6Hx-Bcl4SDE7_Of4UUOKHo8Ye56ud6dlvUe0AVZgEG0
# Sliding login inactivity timeout for staging/production; 0 disables it.
AUTH_SESSION_IDLE_EXPIRE_MINUTES=30
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=Administrator20
MEDIA_ROOT=/app/sounds
LEGACY_PROJECT_DIR=../ecoSound-web
# Public URL of the instance being migrated. Legacy installs leave APP_URL empty and
# resolve the hostname per request, so set this when the migration cannot detect it.
# LEGACY_APP_URL=https://ecosound-web.example.com/ecosound_web
# Federation hub the legacy instance registers with; defaults to the legacy HOST_URL.
# LEGACY_HOST_URL=https://ecosound-web.example.com/ecosound_web


# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=25432
POSTGRES_DB=ecosignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Geo Database (FDW - separate PostGIS instance for IHO/GADM spatial data)
GEO_DB_SERVER=localhost
GEO_DB_PORT=25433
GEO_DB_NAME=geo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Default for local dev (same as RabbitMQ). Override via GitHub secret in staging/production.
REDIS_PASSWORD=ecosignal

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=25672
RABBITMQ_USER=ecosignal
RABBITMQ_PASSWORD=ecosignal
RABBITMQ_VHOST=/
# Local development default. Use a unique, stable random value in each deployment.
RABBITMQ_ERLANG_COOKIE=ecosignal-erlang-cookie

SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENABLE_IN_LOCAL=false
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
SENTRY_PROFILE_LIFECYCLE=trace
SENTRY_SEND_DEFAULT_PII=true
METRICS_ENABLED=true
PROMETHEUS_URL=http://localhost:29090
GRAFANA_URL=http://localhost:23000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_POSTGIS=imresamu/postgis:17-3.5
DOCKER_IMAGE_REDIS=redis:7-alpine
DOCKER_IMAGE_RABBITMQ=rabbitmq:3-management

# Optional: override base images when Docker Hub is unreachable.
# Example public mirror values:
# PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# PYTHON_DEV_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12
# NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:alpine
# POSTGIS_BASE_IMAGE=docker.m.daocloud.io/imresamu/postgis:17-3.5
PYTHON_BASE_IMAGE=python:3.12-slim
PYTHON_DEV_BASE_IMAGE=python:3.12
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:alpine
POSTGIS_BASE_IMAGE=imresamu/postgis:17-3.5
GEO_DB_AUTO_DOWNLOAD=true
GEO_DB_READY_URL=https://github.com/csaay/geo_db/releases/download/v1.0.2/geo_db_ready.zip
GEO_DB_XR_SEED_URL=https://github.com/csaay/geo_db/releases/download/v1.0.2/col_xr_seed.zip

# RabbitMQ Worker
WORKER_PREFETCH_COUNT=1
WORKER_RETRY_MAX_TRIES=5
WORKER_JOB_TIMEOUT=3600
